{
  "name": "unraid-bots",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3847",
    "build": "next build",
    "start": "next start -p ${PORT:-3847}",
    "worker": "tsx worker/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "docker:build": "docker buildx build --platform linux/amd64 --load -t ghcr.io/dotumzane/bots:latest .",
    "docker:publish": "docker buildx build --platform linux/amd64 --push -t ghcr.io/dotumzane/bots:latest ."
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "cheerio": "^1.1.0",
    "concurrently": "^9.2.0",
    "next": "16.2.6",
    "nodemailer": "^7.0.5",
    "p-limit": "^7.1.1",
    "playwright": "^1.54.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.1.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/nodemailer": "^6.4.17",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.12.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  },
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
